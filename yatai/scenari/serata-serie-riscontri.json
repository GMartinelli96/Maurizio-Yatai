[
  { "resize": "360x640" },
  { "goto": "?sviluppo=serata&seme=prova" },
  { "advance": 100 },
  { "expect": "serie.visibile", "equals": false },
  { "expect": "serie.valore", "equals": 0 },
  { "expect": "serie.pof", "equals": null },
  { "shot": "riscontri-0-niente" },

  { "gioca": { "finoA": 4000, "passoMs": 100 } },
  { "expect": "serata.serie", "equals": 1 },
  { "expect": "serie.visibile", "equals": false },
  { "expect": "serie.ultimoPagamento.monete", "equals": 3 },

  { "gioca": { "finoA": 6000, "passoMs": 100 } },
  { "expect": "serata.serie", "equals": 2 },
  { "expect": "serie.visibile", "equals": true },
  { "expect": "serie.testo", "equals": "×2" },
  { "expect": "serie.colore", "equals": "oro" },
  { "expect": "serie.corpo", "equals": 52 },
  { "expect": "serie.x", "atLeast": 500 },
  { "shot": "riscontri-1-compare-x2" },

  { "gioca": { "finoA": 14000, "passoMs": 100 } },
  { "expect": "serie.testo", "equals": "×4" },
  { "expect": "serie.colore", "equals": "oro" },
  { "expect": "serie.corpo", "equals": 65 },
  { "expect": "serie.ultimoPagamento.monete", "equals": 5 },
  { "shot": "riscontri-2-cresce-x4" },

  { "gioca": { "finoA": 22000, "passoMs": 100 } },
  { "expect": "serie.testo", "equals": "×6" },
  { "expect": "serie.colore", "equals": "arcobaleno" },
  { "expect": "serie.corpo", "equals": 78 },
  { "expect": "serie.ultimoPagamento.monete", "equals": 7 },
  { "shot": "riscontri-3-tetto-x6" },

  { "advance": 4600 },
  { "expect": "clienti.1.stato", "equals": "attesa" },
  { "expect": "serie.visibile", "equals": true },
  { "tapPath": "posti.1" },
  { "advance": 120 },
  { "expect": "eventi.contati.serieSpezzata", "equals": 1 },
  { "expect": "serata.serie", "equals": 0 },
  { "expect": "serie.valore", "equals": 0 },
  { "expect": "serie.visibile", "equals": true },
  { "expect": "serie.pof.alpha", "atLeast": 0.1 },
  { "shot": "riscontri-4-pof" },

  { "advance": 150 },
  { "expect": "serie.pof.scala", "atLeast": 0.5 },
  { "shot": "riscontri-4b-pof-aperto" },

  { "advance": 450 },
  { "expect": "serie.visibile", "equals": false },
  { "expect": "serie.pof", "equals": null },
  { "shot": "riscontri-5-sparito" },

  { "gioca": { "finoA": 45000, "passoMs": 1100 } },
  { "expect": "serata.serie", "atLeast": 2 },
  { "expect": "serie.visibile", "equals": true },
  { "expect": "serie.colore", "equals": "oro" },
  { "expect": "serata.serieMax", "atLeast": 6 },
  { "shot": "riscontri-5b-di-nuovo-giallo" },

  { "gioca": { "finoA": 95000, "sbadato": true, "passoMs": 100 } },
  { "expect": "serata.persi", "atLeast": 1 },
  { "expect": "eventi.contati.serieSpezzata", "equals": 2 },
  { "expect": "serie.visibile", "equals": false },
  { "expect": "serie.valore", "equals": 0 },

  { "gioca": { "passoMs": 1100 } },
  { "expect": "serata.fase", "equals": "finita" },
  { "expect": "serie.visibile", "equals": false },
  { "expect": "serie.pof", "equals": null },
  { "shot": "riscontri-6-fine" }
]
